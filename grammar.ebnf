(* Grammar of O-language, in EBNF.
 *
 * Notation:  name ::= right side      a rule
 *            |                        alternatives
 *            [ x ]                    optional
 *            { x }                    zero or more
 *            "x"                      a terminal: a token the lexer emits, with this text
 *            name                     a non-terminal: it has a rule of its own
 *
 * Terminals come straight from the lexer (src/lexer.py):
 *   "doze" "fawty" "line"                          type names: i32, i64, bool
 *   "merch" "woof"                                 boolean literals: true, false
 *   "tuck" "sliding" "post"                        declaration, mutable marker, assignment
 *   "bump" "tuck_in" "double_back"                 + - *
 *   "breakdown" "scraps"                           / %
 *   "in_tune" "fugazi"                             == !=
 *   "spot" "pivot"                                 if, else
 *   "creepin" "ghost"                              open and close a block, around { }
 *   "drill" "cuh" "scat"                           function, return, exit
 *   "on_the_guys" "air_out"                        assert, print
 *   "no_bap"                                       end of a simple statement
 *   "{" "}" "(" ")" ":" ","                        punctuation, one byte each
 *   ident     letters, digits and _, not starting with a digit, and not a keyword
 *   number    decimal digits, no sign, at most 9223372036854775807 (the fawty maximum)
 *   string    bytes between two '"' on one line; only air_out takes one
 *
 * Between tokens: spaces, tabs and newlines, in any amount -- a newline means nothing,
 * a statement ends with "no_bap". The word "lowkey" starts a comment that runs to the end
 * of the line; it never becomes a token, so it is not in the grammar.
 *
 * What this grammar deliberately cannot say (those are semantics, checked in the next
 * stage): that a name is declared before it is used and only once, that only a "sliding"
 * variable is assigned with "post", every type rule and the range of each type (a doze
 * holds 32 bits, a fawty 64), that "cuh" appears only inside a "drill", and that a call
 * passes as many arguments as the function has parameters.
 *)

program   ::= { item }

item      ::= function | statement

function  ::= "drill" ident "(" [ param { "," param } ] ")" [ "cuh" type ] block

param     ::= ident ":" type

block     ::= "creepin" "{" statement { statement } "}" "ghost"

statement ::= decl | assign | call_stmt | if | return | exit | assert | print

decl      ::= "tuck" [ "sliding" ] ident ":" type "post" expr "no_bap"

type      ::= "doze" | "fawty" | "line"

assign    ::= ident "post" expr "no_bap"

call_stmt ::= call "no_bap"

if        ::= "spot" expr block [ "pivot" block ]

return    ::= "cuh" [ expr ] "no_bap"

exit      ::= "scat" [ expr ] "no_bap"

assert    ::= "on_the_guys" "(" expr ")" "no_bap"

print     ::= "air_out" "(" ( string | expr ) ")" "no_bap"

expr      ::= arith [ ( "in_tune" | "fugazi" ) arith ]

arith     ::= term { ( "bump" | "tuck_in" ) term }

term      ::= factor { ( "double_back" | "breakdown" | "scraps" ) factor }

factor    ::= number | "merch" | "woof" | call | ident | "(" expr ")"

call      ::= ident "(" [ expr { "," expr } ] ")"

(* Precedence and associativity come out of the shape of the last five rules, with no
 * table anywhere. A comparison binds weaker than arithmetic, so both sides of "in_tune"
 * are whole chains; expr has no loop, so there is at most one comparison per expression
 * (write ( ) to compare a comparison). Inside a chain, arith calls term before it looks
 * for a "bump", so "double_back" binds tighter than "bump"; each loop keeps what it has so
 * far as the left child, so 10 tuck_in 3 tuck_in 2 is (10 - 3) - 2.
 *
 * Statements with a block ("spot", "drill") end with "ghost" and take no "no_bap";
 * every other statement ends with "no_bap". A block always has at least one statement,
 * and a function is declared only at the top level, never inside a block.
 *
 * assign and call_stmt both start with ident: the parser eats the name and then decides
 * by the next token -- "post" or "(".
 *)
