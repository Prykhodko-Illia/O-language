Program
  Function add returns fawty
    Param a doze
    Param b fawty
    Body
      Return
        BinOp bump (+)
          Var a
          Var b
  Decl small doze sliding
    Int 7
  Decl big fawty sliding
    Var small
  Assign big
    Call add (2 args)
      Var small
      Var small
  Print
    Var big
