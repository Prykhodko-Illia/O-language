Program
  Decl x fawty sliding
    Int 5
  If with pivot
    Cond
      BinOp fugazi (!=)
        Var x
        Int 0
    Then
      If with pivot
        Cond
          BinOp in_tune (==)
            Var x
            Int 5
        Then
          Assign x
            Int 50
        Else
          If
            Cond
              Bool merch
            Then
              Assign x
                Int 1
    Else
      Exit
        Int 1
